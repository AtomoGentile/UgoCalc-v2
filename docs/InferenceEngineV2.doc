\clbrdrt\brdrs\brdrw10\clbrdrl\brdrs\brdrw10\clbrdrb\brdrs\brdrw10\clbrdrr\brdrs\brdrw10\cellx9500
\pard\intbl\b\fs18 Ambito\cell Decisione\cell\b0\row
\pard\intbl\fs18 Percezione visiva\cell Una sola chiamata unificata per scala, inventario e misure grezze\cell\row
\pard\intbl\fs18 Peso in grammi\cell Sempre calcolato da un motore fisico deterministico, mai dichiarato direttamente dal modello\cell\row
\pard\intbl\fs18 Tassonomia alimenti\cell Sei categorie definite dalla strategia di calcolo, non dalla geometria o dalla composizione\cell\row
\pard\intbl\fs18 Verifica\cell Sempre attiva e deterministica; intervento del modello solo sugli alimenti segnalati\cell\row
\pard\intbl\fs18 Motore nutrizionale\cell Quello della V1, gi\'e0 solido, senza riscritture\cell\row
\pard\intbl\fs18 Prerequisito di sviluppo\cell Benchmark pesato, casa e ristorante, prima di scrivere qualunque modulo\cell\row
\pard\intbl\fs18 Ancora di scala principale\cell Riferimenti corporei e universali, non le stoviglie di casa\cell\row
\pard\intbl\fs18 Modalit\'e0 di sessione\cell Selezione esplicita mia a inizio sessione, mai dedotta dall'immagine\cell\row
\pard\intbl\fs18 Calibrazione\cell Due meccanismi distinti: stoviglie di casa e riferimenti corporei condivisi\cell\row
}
\pard\par
